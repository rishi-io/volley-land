{
  "name": "@volleyland/server",
  "version": "0.0.0",
  "private": true,
  "description": "Authoritative NestJS backend: HTTP API, Socket.IO game gateway and domain services.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch dist/main.js",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.30.1",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/platform-socket.io": "^12.1.2",
    "@nestjs/websockets": "^12.1.2",
    "@volleyland/contracts": "workspace:^",
    "@volleyland/game-core": "workspace:^",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@swc/core": "^1.13.0",
    "@types/node": "^24.0.0",
    "socket.io-client": "^4.8.4",
    "typescript": "~6.0.3",
    "unplugin-swc": "^1.5.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
