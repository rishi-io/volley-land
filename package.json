{
  "name": "volleyland",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "dev": "turbo run dev --filter=@volleyland/server --filter=@volleyland/web",
    "dev:server": "turbo run dev --filter=@volleyland/server",
    "dev:web": "turbo run dev --filter=@volleyland/web",
    "audio:generate": "node --env-file-if-exists=.env.local scripts/generate-audio.ts",
    "audio:samples": "node --env-file-if-exists=.env.local scripts/voice-samples.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "turbo": "^2.11.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
