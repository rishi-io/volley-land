# Copy to deploy/.env on the VPS (never commit the real one).
VOLLEYLAND_DOMAIN=play.example.org
# Immutable image tag — use the git commit SHA, never "latest".
VOLLEYLAND_VERSION=0000000
DEV_ROOM_CODE=DEV
# Bearer token for the admin panel at /admin (at least 16 characters), e.g. `openssl rand -hex 24`.
# Game rules, rooms, bots and worlds are managed there, not in env.
ADMIN_TOKEN=
