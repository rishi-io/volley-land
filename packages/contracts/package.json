{
  "name": "@volleyland/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Zod wire schemas, DTO-safe types and socket event contracts. Never contains answer keys.",
  "type": "module",
  "exports": {
    ".": {
      "@volleyland/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
