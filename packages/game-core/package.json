{
  "name": "@volleyland/game-core",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic math, collision primitives and game constants shared by client prediction and server validation.",
  "type": "module",
  "exports": {
    ".": {
      "@volleyland/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
